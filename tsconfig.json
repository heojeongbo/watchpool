{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"verbatimModuleSyntax": true,
		"noEmit": true
	},
	"include": ["src", "tests", "scripts/*.ts", "vitest.config.ts", "examples"]
}
